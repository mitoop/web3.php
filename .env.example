WEB3_RUN_INTEGRATION=0

# ---------------------------------------------------------------------------
# 本地集成测试：用 generateWallet() 生成后填入，并向你自己的地址打测试币
#
# 打测试币示例（替换成你的地址）：
#   Ethereum Sepolia  → <WEB3_EVM_ADDRESS>  （建议 ≥ 0.01 ETH）
#   BSC Testnet       → <WEB3_EVM_ADDRESS>  （少量 tBNB）
#   Polygon Amoy      → <WEB3_EVM_ADDRESS>  （少量 POL）
#   Tron Nile         → <WEB3_TRON_ADDRESS> （建议 ≥ 2 TRX）
# ---------------------------------------------------------------------------

# EVM：Sepolia / BSC Testnet / Amoy 共用同一把私钥
WEB3_EVM_PRIVATE_KEY=
WEB3_EVM_ADDRESS=

WEB3_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WEB3_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
WEB3_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Tron Nile
WEB3_TRON_PRIVATE_KEY=
WEB3_TRON_ADDRESS=
WEB3_TRON_NILE_RPC_URL=https://nile.trongrid.io
WEB3_TRON_NILE_API_KEY=
