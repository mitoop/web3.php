{
    "name": "mitoop/web3.php",
    "description": "Unified multi-chain wallet, balance, and transfer helpers for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "mitoop",
            "email": "me@mitoop.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-gmp": "*",
        "guzzlehttp/guzzle": "^7.9|^8.3",
        "kornrunner/ethereum-offline-raw-tx": "^0.8.0",
        "kornrunner/keccak": "^1.1",
        "simplito/elliptic-php": "^1.0",
        "stephenhill/base58": "^1.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mitoop\\Web3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mitoop\\Web3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint"
    }
}
